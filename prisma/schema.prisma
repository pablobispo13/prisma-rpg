generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

///////////////////////
// ENUMS
///////////////////////

enum Role {
  MESTRE
  JOGADOR
}

enum ActionType {
  ATTACK
  TEST
  SKILL
  REACT
  SPELL
  HEAL
  BUFF
  DEBUFF
  SUPPORT
  // Ataque certeiro: sempre acerta e é sempre crítico, ignorando defesa,
  // teste resistido e reação do alvo (esquiva/bloqueio/contra-ataque). Em
  // troca, aplica automaticamente os efeitos SELF do preset (ex: debuff de
  // atributo no próprio conjurador) — ver POST /roll.
  CERTAIN_STRIKE
  // Assumir uma forma alternativa do personagem (ver Character.forms).
  // Preset gerado automaticamente pelo sistema (POST .../forms), não
  // selecionável manualmente no editor de habilidades — ver targetFormId.
  TRANSFORM
}

// Atributos não são mais um enum fixo — ver CustomAttribute e
// src/lib/attributes.ts. "Atributo" em qualquer campo do schema (attribute,
// contestAttribute, statAffected) é uma string: um dos 5 nomes fixos em
// maiúsculo (STRENGTH/AGILITY/VIGOR/INTELLECT/PRESENCE, colunas escalares de
// Character) ou a `key` (slug minúsculo) de um CustomAttribute da mesa.

enum TargetType {
  SELF
  ALLY
  ENEMY
  MULTIPLE
}

enum LogType {
  ROLL
  DAMAGE
  HEAL
  HEAL_OVER_TIME
  DAMAGE_OVER_TIME
  COMBAT_START
  COMBAT_END
  TURN_START
  TURN_END
  MANUAL_OVERRIDE
  REACTION
}

enum StatusType {
  STUNNED
  POISONED
  BURNED
  FROZEN
}

enum EffectType {
  HEAL_OVER_TIME
  DAMAGE_OVER_TIME
  STAT_BUFF
  STAT_DEBUFF
  DEFENSE_BUFF
  DEFENSE_DEBUFF
  TEMP_HP
  STUN
  ROLL_BONUS
  ROLL_PENALTY
  ADVANTAGE
  DISADVANTAGE
  CONTROLLED
  DAMAGE_TAKEN_BONUS
  SANITY_DRAIN // desconta Character.sanity (custo de usar a habilidade)
}

// Como a rolagem do preset é resolvida contra o alvo
enum ResolutionType {
  DEFENSE // total do atacante vs defesa efetiva do alvo (padrão)
  CONTESTED // teste resistido: total vs 1d20 + atributo do alvo
  AUTO // aplica sem teste (buffs em aliados, efeitos automáticos)
}

// Como o jogador escolhe entre os efeitos de um preset multi-efeito
enum EffectSelectionMode {
  ALL // aplica todos de uma vez (habilidade composta)
  CHOOSE_ONE // jogador escolhe exatamente 1 (cenários/modos)
  CHOOSE_ANY // jogador escolhe um subconjunto (mínimo 1)
}

// Em quem cada PresetEffect é aplicado
enum EffectTarget {
  SELF // o conjurador
  TARGETS // os alvos selecionados na ação
}

///////////////////////
// USER
///////////////////////

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  role      Role
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  characters      Character[]
  ownedCampaigns  Campaign[]       @relation("CampaignMaster")
  campaignMembers CampaignMember[]
}

///////////////////////
// CAMPAIGN (MESA)
///////////////////////

model Campaign {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  image       String?
  streamUrl   String? // deprecated — não usado mais, substituído por compartilhamento de tela (screenShare*)
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  // Compartilhamento de tela ao vivo (WebRTC) do mestre. screenShareSessionId
  // identifica a sessão de broadcast corrente (desempate entre abas do
  // mestre e detecção de sessão obsoleta por quem entra depois).
  screenShareActive    Boolean   @default(false)
  screenShareSessionId String?
  screenShareUpdatedAt DateTime?

  // Fórmulas de atributos derivados configuráveis pelo mestre.
  // null = usa a fórmula padrão do sistema. Variáveis: forca, agilidade,
  // vigor, intelecto, presenca (ou equivalentes em inglês).
  defenseFormula String?
  maxLifeFormula String?

  // Limite de reações em combate por rodada (configurável pelo mestre).
  // null = ilimitado (comportamento clássico). Ataques extras são concedidos
  // por personagem via Character.maxAttacksPerRound (base: 1 por rodada).
  reactionsPerRound Int?

  // Cor de destaque da imagem do personagem na ficha (hex, ex: #FF3D00).
  // null = cor padrão do sistema (laranja)
  characterImageColor String?

  // Dia atual do mundo da mesa (controlado pelo mestre). null = dia 1.
  // Avançar o dia (POST /campaigns/[id]/advance-day) libera de novo os usos
  // diários de habilidades (ActionPreset.usesPerDay).
  worldDay Int?

  // Custo de sanidade cobrado automaticamente do CONJURADOR em toda
  // habilidade usada (qualquer ActionPreset, via POST /roll), além de
  // qualquer PresetEffect SANITY_DRAIN específico daquela habilidade.
  // null = sem custo automático. Configurável só pelo mestre (PATCH desta
  // rota já exige access.isMaster). Override por personagem em
  // Character.abilitySanityCostOverride.
  abilitySanityCost Int?

  masterId String @db.ObjectId
  master   User   @relation("CampaignMaster", fields: [masterId], references: [id])

  members          CampaignMember[]
  invites          CampaignInvite[]
  characters       Character[]
  combats          Combat[]
  customAttributes CustomAttribute[]
}

model CampaignMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([campaignId, userId])
}

model CampaignInvite {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  code      String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  maxUses   Int?
  uses      Int       @default(0)
  active    Boolean   @default(true)
}

///////////////////////
// CUSTOM ATTRIBUTE (por mesa)
///////////////////////

// Atributo extra definido pelo mestre (ex: Maestria, Sorte), além dos 5 fixos
// (Character.strength/agility/vigor/intellect/presence). Funciona como um
// atributo de verdade: pode ser usado em ActionPreset.attribute/
// contestAttribute, PresetEffect/CharacterEffect.statAffected e nas fórmulas
// de vida/defesa da mesa — ver src/lib/attributes.ts. `key` é o slug estável
// (minúsculo, só letras) usado nesses campos e como variável de fórmula;
// `label` é o nome exibido, editável livremente.
model CustomAttribute {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String
  label        String
  defaultValue Int      @default(0)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
}

///////////////////////
// CHARACTER
///////////////////////

model Character {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  life      Int
  maxLife   Int
  xp        Int
  strength  Int
  agility   Int
  vigor     Int
  intellect Int
  presence  Int

  // Valores dos atributos customizados da mesa: { [CustomAttribute.key]: valor }.
  // Populado com o defaultValue ao criar o personagem ou quando um atributo
  // novo é criado na mesa (ver POST /campaigns/[id]/attributes). Chave
  // ausente = trata como 0 (ver src/lib/attributes.ts::getAttributeValue).
  customAttributes Json?

  baseDefense Int @default(0)

  // Sanidade — controlada exclusivamente pelo mestre; a API oculta estes
  // dois campos das respostas para jogadores (ver hideCharacterSanity em
  // src/lib/campaignAccess.ts). null = sanidade não rastreada neste
  // personagem. Descontada automaticamente por PresetEffect do tipo
  // SANITY_DRAIN (ex: custo de usar uma habilidade) ou manualmente pelo
  // mestre (PUT /characters/[id] ou ação "adjustSanity" em combate).
  sanity                    Int?
  maxSanity                 Int?
  // Override do custo automático de sanidade por habilidade (Campaign.
  // abilitySanityCost). null = usa o da mesa. Mesma visibilidade restrita
  // ao mestre que sanity/maxSanity (ver hideCharacterSanity).
  abilitySanityCostOverride Int?

  // Overrides por personagem dos limites da mesa (null = usa o da campanha).
  // Permite habilidades tipo "reage 2x por rodada" ou "ataque extra".
  maxReactionsPerRound Int?
  maxAttacksPerRound   Int?

  // Vantagem/desvantagem: modificador aplicado a TODA rolagem deste
  // personagem (ataque, teste, reação) na rodada corrente, setado pelo
  // mestre em combate (POST /combat/control, action "setRollModifier").
  // Limpo automaticamente quando a rodada avança (ver combat/control.ts,
  // startTurn/endTurn) — não precisa de combatId/turnId aqui porque o reset
  // é feito de fora, por quem controla o avanço de rodada.
  pendingRollModifier Int?

  // Limite de transformações por dia (configurado na ficha principal).
  // Conta apenas assumir uma forma; voltar à base é livre. Escopado ao
  // Campaign.worldDay — o mestre avança o dia para liberar de novo (ver
  // CharacterTransformationDailyUsage). null = ilimitado
  maxTransformationsPerDay Int?

  // Formas alternativas (ex: transformação em zumbi): cada forma é um
  // Character "irmão" completo apontando para o principal. Formas não
  // aparecem nas listagens; o principal guarda qual ficha está ativa.
  primaryFormId String?     @db.ObjectId
  primaryForm   Character?  @relation("CharacterForms", fields: [primaryFormId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forms         Character[] @relation("CharacterForms")
  activeFormId  String?     @db.ObjectId // null = a própria ficha principal

  history       String?
  notes         String?
  image         String?
  // Presets automáticos de defesa
  dodgePresetId String?       @db.ObjectId
  dodgePreset   ActionPreset? @relation("DodgePreset", fields: [dodgePresetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  blockPresetId String?       @db.ObjectId
  blockPreset   ActionPreset? @relation("BlockPreset", fields: [blockPresetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  counterAttackPresetId String?       @db.ObjectId
  counterAttackPreset   ActionPreset? @relation("CounterAttackPreset", fields: [counterAttackPresetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  ownerId String @db.ObjectId
  owner   User   @relation(fields: [ownerId], references: [id])

  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  presets   ActionPreset[] @relation("CharacterPresets")
  inventory Inventory[]

  actionLogs ActionLog[] @relation("ActionAuthor")
  targetLogs ActionLog[] @relation("ActionTarget")

  combatParticipants CombatParticipant[]
  turns              CombatTurn[]

  rollResults RollResult[]

  // Status temporários
  statusEffects CharacterEffect[]
  dailyUsages   PresetDailyUsage[]
  transformationDailyUsages CharacterTransformationDailyUsage[]

  // Presets type=TRANSFORM (de qualquer personagem) que apontam pra esta
  // forma como alvo — ver ActionPreset.targetFormId
  transformPresets ActionPreset[] @relation("TransformTargetForm")
}

///////////////////////
// ACTION PRESET
///////////////////////

model ActionPreset {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String

  type       ActionType
  targetType TargetType

  diceFormula   String // rolagem de ataque / teste
  impactFormula String? // rolagem de dano OU cura
  modifier      Int     @default(0)

  critThreshold  Int?
  critMultiplier Float?

  requiresTurn     Boolean @default(true)
  allowOutOfCombat Boolean @default(false)
  appliesEffect    Boolean @default(true)
  isAreaEffect     Boolean @default(false)
  // Habilidade que pertence à forma transformada: em combate, a ficha
  // transformada mostra apenas as marcadas e a ficha base as esconde
  transformedOnly  Boolean @default(false)

  attribute String

  // Resolução da rolagem contra o alvo (DEFENSE = comportamento clássico)
  resolution       ResolutionType @default(DEFENSE)
  // Atributo do alvo no teste resistido (null = mesmo atributo do preset)
  contestAttribute String?

  // Limite de usos por dia (por personagem). null = ilimitado. O "dia"
  // é o Campaign.worldDay; o mestre avança o dia e o limite libera de novo.
  usesPerDay Int?

  // Só quando type=TRANSFORM: forma que este preset assume ao ser usado.
  // null = volta à forma base (o próprio personagem principal). Gerado
  // automaticamente em POST /characters/[id]/forms — ver Character.maxTransformationsPerDay
  // (o limite diário continua por personagem, não por preset).
  targetFormId String?    @db.ObjectId
  targetForm   Character? @relation("TransformTargetForm", fields: [targetFormId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Multi-efeito: quando o preset tem linhas em `effects`, elas substituem os
  // campos legados abaixo (durationTurns/statAffected/effectAmount/...)
  effectSelectionMode EffectSelectionMode @default(ALL)
  effects             PresetEffect[]

  // Campos legados de efeito único (presets antigos; migrados por
  // scripts/backfill-preset-effects.ts e mantidos como fallback)
  durationTurns Int?
  statAffected  String?
  effectAmount  Int?
  statusApplied StatusType?
  effectType    EffectType?

  characterId String    @db.ObjectId
  character   Character @relation("CharacterPresets", fields: [characterId], references: [id])

  dodgeCharacters         Character[] @relation("DodgePreset")
  blockCharacters         Character[] @relation("BlockPreset")
  counterAttackCharacters Character[] @relation("CounterAttackPreset")

  rolls            RollResult[]
  inventories      Inventory[]
  characterEffects CharacterEffect[]
  dailyUsages      PresetDailyUsage[]
}

///////////////////////
// PRESET EFFECT (multi-efeito)
///////////////////////

// Uma linha de efeito configurável de um ActionPreset. Presets podem ter
// várias; o jogador escolhe quais aplicar conforme effectSelectionMode.
model PresetEffect {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  presetId String       @db.ObjectId
  preset   ActionPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  name        String // rótulo mostrado na modal de escolha ("Quebrar armadura")
  description String?

  effectType    EffectType
  target        EffectTarget   @default(TARGETS)
  value         Int?
  // Fórmula de dado para o valor (ex: "1d6"). DAMAGE_TAKEN_BONUS rola a cada
  // ataque recebido; demais tipos rolam uma vez na aplicação.
  valueFormula  String?
  statAffected  String?
  statusApplied StatusType?
  durationTurns Int?

  // Reteste por rodada (efeitos resistidos, ex: controle mental):
  // o alvo repete o teste no início do próprio turno contra o total do
  // conjurador, que decai contestDecay por rodada. Vence = efeito removido.
  retestEachRound Boolean @default(false)
  contestDecay    Int?

  sortOrder Int @default(0)

  characterEffects CharacterEffect[]
}

///////////////////////
// USO DIÁRIO DE HABILIDADE
///////////////////////

// Contador de uso de um ActionPreset por personagem, escopado ao worldDay
// vigente na criação da linha. Cada avanço de dia gera uma linha nova (a
// anterior fica como histórico) — evita ter que "zerar" contadores.
model PresetDailyUsage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  characterId String    @db.ObjectId
  character   Character @relation(fields: [characterId], references: [id])

  presetId String       @db.ObjectId
  preset   ActionPreset @relation(fields: [presetId], references: [id])

  worldDay  Int
  usedCount Int @default(0)

  @@unique([characterId, presetId, worldDay])
}

///////////////////////
// USO DIÁRIO DE TRANSFORMAÇÃO
///////////////////////

// Contador de transformações do personagem (ficha principal), escopado ao
// worldDay vigente na criação da linha — mesmo padrão de PresetDailyUsage,
// mas por personagem (não há preset envolvido). Voltar à forma base não
// consome; ver Character.maxTransformationsPerDay e switch-form.ts.
model CharacterTransformationDailyUsage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  characterId String    @db.ObjectId
  character   Character @relation(fields: [characterId], references: [id])

  worldDay  Int
  usedCount Int @default(0)

  @@unique([characterId, worldDay])
}

///////////////////////
// ROLL RESULT
///////////////////////

model RollResult {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  characterId String    @db.ObjectId
  character   Character @relation(fields: [characterId], references: [id])

  presetId String?       @db.ObjectId
  preset   ActionPreset? @relation(fields: [presetId], references: [id])

  combatId String? @db.ObjectId
  combat   Combat? @relation(fields: [combatId], references: [id])

  turnId String?     @db.ObjectId
  turn   CombatTurn? @relation(fields: [turnId], references: [id])

  targetIds String[] @db.ObjectId

  // Fórmula já com {{atributo}} resolvido pro valor no momento da rolagem
  // (ex: "8d20", não "{{força}}d20") — é o que fica gravado no histórico,
  // pra sempre exibir o dado de verdade usado, mesmo que o atributo do
  // personagem mude depois (ver src/lib/attributes.ts::substituteAttributeVariables)
  diceRolled String
  rolls      Int[]
  modifier   Int
  total      Int
  // Dados de "N#dM" (mantém-o-maior) rolados mas não contados no total —
  // só para exibir o breakdown completo da rolagem (ver src/lib/dice.ts)
  droppedRolls Int[] @default([])

  impactRolls        Int[] @default([]) // Rolls do dano/cura (ex: [3, 2, 1])
  impactDroppedRolls  Int[] @default([]) // Idem droppedRolls, para o impactFormula
  // Mesma ideia de diceRolled, mas pro impactFormula (ex: "1d6+8") — usado
  // pela UI no lugar do preset.impactFormula "cru" (que pode ter mudado ou
  // ter {{atributo}} não resolvido)
  impactFormulaResolved String?

  success  Boolean? // Será definido após reação do alvo
  critical Boolean

  damage  Int?
  healing Int?

  // Reações
  pendingReaction        Boolean @default(false)
  reactionType           String?
  reacted                Boolean @default(false)
  pendingReactionTargets Json[]  @default([])

  createdAt DateTime @default(now())

  logs    ActionLog[]        @relation("RollLogs")
  details RollResultDetail[] @relation("RollDetails")
}

///////////////////////
// ROLL RESULT DETAIL
///////////////////////

model RollResultDetail {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  rollResultId String     @db.ObjectId
  rollResult   RollResult @relation("RollDetails", fields: [rollResultId], references: [id])

  targetId String @db.ObjectId

  // Antes da ação
  beforeLife Int?

  // Resultado
  succeeded      Boolean
  critical       Boolean
  damageApplied  Int?
  healingApplied Int?

  // Defesa (para breakdown visual)
  targetDefense Int?
}

///////////////////////
// ACTION LOG
///////////////////////

model ActionLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  type    LogType
  message String

  // Log visível apenas para o mestre (ex: ajuste manual de HP).
  // Nullable para compatibilidade com documentos antigos no Mongo.
  masterOnly Boolean?

  characterId String?    @db.ObjectId
  character   Character? @relation("ActionAuthor", fields: [characterId], references: [id])

  targetId String?    @db.ObjectId
  target   Character? @relation("ActionTarget", fields: [targetId], references: [id])

  rollId String?     @db.ObjectId
  roll   RollResult? @relation("RollLogs", fields: [rollId], references: [id])

  combatId String? @db.ObjectId
  combat   Combat? @relation("CombatLogs", fields: [combatId], references: [id])

  turnId String?     @db.ObjectId
  turn   CombatTurn? @relation("TurnLogs", fields: [turnId], references: [id])

  createdAt DateTime @default(now())
}

///////////////////////
// INVENTORY
///////////////////////

model Inventory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  quantity    Int
  description String?

  characterId String    @db.ObjectId
  character   Character @relation(fields: [characterId], references: [id])

  presetId String?       @db.ObjectId // vincula item a preset
  preset   ActionPreset? @relation(fields: [presetId], references: [id])
}

///////////////////////
// COMBAT
///////////////////////

model Combat {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  active Boolean @default(true)
  round  Int     @default(1)

  currentTurnIndex Int @default(0)

  streamUrl   String?
  hpSnapshots Json[]  @default([])

  createdAt DateTime @default(now())

  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  participants CombatParticipant[]
  turns        CombatTurn[]
  logs         ActionLog[]         @relation("CombatLogs")
  rollResults  RollResult[]
}

model CombatParticipant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  combatId String @db.ObjectId
  combat   Combat @relation(fields: [combatId], references: [id])

  characterId String    @db.ObjectId
  character   Character @relation(fields: [characterId], references: [id])

  currentLife Int
  tempHp      Int  @default(0)
  initiative  Int?
  turnOrder   Int?

  // Contadores da rodada atual — zerados quando a rodada avança (control.ts)
  attacksUsed   Int @default(0)
  reactionsUsed Int @default(0)
}

///////////////////////
// COMBAT TURNOS
///////////////////////

model CombatTurn {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  combatId String @db.ObjectId
  combat   Combat @relation(fields: [combatId], references: [id])

  characterId String    @db.ObjectId
  character   Character @relation(fields: [characterId], references: [id])

  turnNumber Int
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  logs        ActionLog[]  @relation("TurnLogs")
  rollResults RollResult[]
}

///////////////////////
// EFFECTS TEMPORÁRIOS
///////////////////////

model CharacterEffect {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  characterId String    @db.ObjectId
  character   Character @relation(fields: [characterId], references: [id])

  presetId String       @db.ObjectId
  preset   ActionPreset @relation(fields: [presetId], references: [id])

  // Linha de efeito que originou (null em efeitos legados de efeito único)
  presetEffectId String?       @db.ObjectId
  presetEffect   PresetEffect? @relation(fields: [presetEffectId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // Quem aplicou o efeito (controlador, autor da marca, etc.)
  sourceCharacterId String? @db.ObjectId

  remainingTurns Int
  appliedAt      DateTime       @default(now())
  type           EffectType
  value          Int
  // Fórmula rolada a cada gatilho (ex: DAMAGE_TAKEN_BONUS "1d6" por ataque)
  valueFormula   String?
  statAffected   String?
  statusApplied  StatusType?

  // Estado do reteste por rodada (efeitos resistidos)
  retestEachRound  Boolean @default(false)
  contestValue     Int? // total atual a bater; decai contestDecay por rodada
  contestDecay     Int?
  contestAttribute String?
}
